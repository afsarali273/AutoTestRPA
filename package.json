{
  "name": "unified-automation-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:web": "pnpm --filter @uap/cli-web dev",
    "dev:api": "pnpm --filter @uap/cli-api dev",
    "dev:device": "pnpm --filter @uap/cli-appium dev",
    "dev:control-api": "pnpm --filter @uap/control-center-api dev",
    "dev:ui": "pnpm --filter @uap/control-center dev",
    "dev:orchestrator": "pnpm --filter @uap/mcp-orchestrator dev"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
